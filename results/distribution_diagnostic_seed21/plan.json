  "metrics_contract": {
    "scaling": "existing frozen JCAS standardized coordinates; divide10 only; no second z-score",
    "selected_embedding": "selected24/(10*sqrt24)",
    "joint_embedding": "concat(selected24/(10*sqrt24),clean_conditions6/(10*sqrt6))",
    "kernels": "RBF exp(-squared_distance/(2*sigma_squared)); biased MMD squared V-stat includes diagonals",
    "bandwidth": "selected/joint each use all-clean-train median positive pairwise distance; shared across arms and strata",
    "marginal_distance": "mean of24 one-dimensional empirical Wasserstein-1 distances in existing standardized units",
    "reference_strata": "train all/slow/moving matched to original clean audit strata, never regroup triggered outputs",
    "anomaly": "strict outside per-stratum train .01/.99 linear empirical quantiles; both coordinate and row rates",
    "boundary": "abs(abs(value)-10)<=1e-6, relative_tolerance0",
    "modifications": "trigger minus same target clean: L1,L2,Linf in existing standardized units",
    "baseline": "clean audit versus clean train with exactly the same metrics and bandwidth",
    "absent_stratum": "explicit unavailable, no borrowing another reference population",
    "inference": "descriptive distances, no significance tests, no tuned thresholds or bandwidth search"
  },
